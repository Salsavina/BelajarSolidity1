pragma solidity 0.8.30;

contract Manufacture {
    struct Product {
        string productName;
        uint256 productPrice;
    }

    mapping(uint256 => Product) public productDetails; // key pake uint256
    uint256 public id = 0; // id auto increment

    function addItems(string memory _productName, uint256 _productPrice) public {
        productDetails[id] = Product(_productName, _productPrice);
        id++;
    }
    
    function getItems(uint256 _id) public view returns (string memory, uint256) {
        Product memory b = productDetails[_id];
        return (b.productName, b.productPrice);
    }
}
